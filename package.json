{
  "name": "theshook.one",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "astro:dev": "astro dev",
    "astro:build": "astro build",
    "astro:preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "dev": "wrangler types && npm run astro:build && wrangler dev --test-scheduled",
    "kv:update": "curl \"http://localhost:8787/__scheduled?cron=0+*+*+*+*\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.5",
    "astro": "7.2.9",
    "fast-xml-parser": "5.11.1"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "wrangler": "4.127.1"
  }
}
